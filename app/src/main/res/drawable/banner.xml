<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a0a0f" />
            <size
                android:width="320dp"
                android:height="180dp" />
        </shape>
    </item>

    <!-- Green dot -->
    <item
        android:left="80dp"
        android:top="75dp"
        android:width="16dp"
        android:height="16dp">
        <shape android:shape="oval">
            <solid android:color="#1ce783" />
        </shape>
    </item>

    <!-- "live" text - using vector paths -->
    <item
        android:gravity="center"
        android:width="200dp"
        android:height="60dp">
        <vector
            android:width="200dp"
            android:height="60dp"
            android:viewportWidth="200"
            android:viewportHeight="60">

            <!-- "l" -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M45,10 L45,50 L52,50 L52,10 Z"/>

            <!-- "i" -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M58,10 L58,16 L65,16 L65,10 Z M58,22 L58,50 L65,50 L65,22 Z"/>

            <!-- "v" -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M70,10 L80,50 L87,50 L97,10 L90,10 L83.5,40 L77,10 Z"/>

            <!-- "e" -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M102,10 C95,10 92,18 92,30 C92,42 95,50 102,50 L118,50 L118,43 L104,43 C100,43 99,38 99,33 L118,33 L118,27 L99,27 C99,22 100,17 104,17 L118,17 L118,10 Z"/>

            <!-- ".tv" in muted color -->
            <!-- dot -->
            <path
                android:fillColor="#6b7280"
                android:pathData="M128,44 L128,50 L134,50 L134,44 Z"/>

            <!-- "t" -->
            <path
                android:fillColor="#6b7280"
                android:pathData="M140,10 L140,17 L145,17 L145,50 L152,50 L152,17 L162,17 L162,10 Z"/>

            <!-- "v" -->
            <path
                android:fillColor="#6b7280"
                android:pathData="M160,10 L170,50 L177,50 L187,10 L180,10 L173.5,40 L167,10 Z"/>
        </vector>
    </item>
</layer-list>
